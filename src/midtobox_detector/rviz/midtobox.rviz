Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Axis: Z
      Enabled: true
      Name: RawLidarCloud
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /livox/lidar
    - Alpha: 1.0
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 200; 40
      Color Transformer: FlatColor
      Enabled: true
      Name: NonGroundDebugCloud
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /midtobox/debug/non_ground_cloud
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MidtoboxMarkers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /midtobox/markers
    - Axes Length: 0.35
      Axes Radius: 0.02
      Class: rviz_default_plugins/Pose
      Color: 0; 255; 100
      Enabled: true
      Name: PrimaryTargetPose
      Shape: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /midtobox/target_pose
  Enabled: true
  Global Options:
    Background Color: 35; 35; 42
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Focal Point:
        X: 1.5
        Y: 0.0
        Z: 0.2
      Pitch: 0.55
      Yaw: 3.14
Window Geometry:
  Height: 800
  Width: 1200
